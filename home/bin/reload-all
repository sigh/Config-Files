#!/usr/bin/env bash
#
# send CONT to login shells to trigger their configured reload behavior.
# Assumes the following (or equivalent) is defined in the shell:
#   trap ". ~/.bashrc" CONT
# SIGCONT is used because it does not terminate the shell by default.

echo -n 'Reloading '
ps xwwo pid,command | while read pid command; do
    if [[ $command =~ ^-(bash|zsh)$ ]]; then
        echo -n $pid ''
        kill -CONT $pid
    fi
done
echo
